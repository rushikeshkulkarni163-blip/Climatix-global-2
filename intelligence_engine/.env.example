# Climactix Intelligence Engine — service-local environment (EXAMPLE)
# Copy to .env for standalone (non-docker-compose) runs. When run via the
# root docker-compose.yml, these are injected by that file instead.

# ── Database (auto-migrated on startup — see database.py) ───────────────────
DATABASE_URL=postgresql://climactix:climactix@localhost:5432/climactix

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── App secret ────────────────────────────────────────────────────────────────
SECRET_KEY=

# ── Earth Observation & Climate Data Repository (all optional — demo mode
# without them; see /docs/earth-observation-architecture.md) ────────────────
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDS_API_TOKEN=
USGS_M2M_USERNAME=
USGS_M2M_APP_TOKEN=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
