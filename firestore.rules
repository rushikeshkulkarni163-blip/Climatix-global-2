// ── Climactix Global · Firestore Security Rules ────────────────────────────
//
// Matches the storage model in community.js: ONE DOCUMENT PER ITEM (one
// post = one document, one profile = one document, ...) instead of one
// blob document per CX.* key holding a whole array. Full design: see
// DB_SCHEMA.md.
//
// This replaces the previous "authenticated = full read/write access to
// the entire blob" model, which could not enforce "you may only delete
// your own post" or "you may not edit someone else's climate score" — any
// authenticated caller could overwrite any user's entire data. These rules
// check field-level ownership instead.
//
// Deploy: Firebase Console → Firestore Database → Rules tab → paste this in
// → Publish. (Or `firebase deploy --only firestore:rules` with the CLI.)

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChangedFields(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Risk OS — company-membership helpers ────────────────────────────
    // Membership doc id is `${companyId}_${uid}` in ros_members_v1 — the
    // Firestore equivalent of the Postgres RLS company-isolation policy
    // this replaced. See RISK_OS_COLLABORATION_ARCHITECTURE.md.
    function rosMemberId(companyId) { return companyId + '_' + request.auth.uid; }
    function isCompanyMember(companyId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/ros_members_v1/$(rosMemberId(companyId)));
    }
    function memberRole(companyId) {
      return get(/databases/$(database)/documents/ros_members_v1/$(rosMemberId(companyId))).data.role;
    }
    function hasAnyRole(companyId, roles) {
      return isCompanyMember(companyId) && memberRole(companyId) in roles;
    }
    function rosWriteRoles()    { return ['administrator', 'assessment_owner', 'contributor']; }
    function rosReviewRoles()   { return ['reviewer', 'approver', 'administrator']; }
    function rosAdminRoles()    { return ['administrator', 'assessment_owner']; }

    function companyOfAssessment(assessmentId) {
      return get(/databases/$(database)/documents/ros_assessments_v1/$(assessmentId)).data.companyId;
    }

    // ── Climactix internal/backend team — cross-company, NOT scoped to any
    // one ros_members_v1 company membership. CLAUDE.md's third user role
    // ("Climactix Internal Team — review/modify assessments...") is global
    // by definition: a Climactix analyst reviews assessments across every
    // client company, not just companies they were individually added to.
    // Membership in cx_staff_v1 is Admin-SDK/console-managed only (see the
    // collection's own rule below) — never client-writable, so a company
    // user can never self-grant Climactix staff access to their own or any
    // other company's evidence intelligence.
    function isClimactixStaff() {
      return signedIn() &&
        exists(/databases/$(database)/documents/cx_staff_v1/$(request.auth.uid));
    }
    // Composite read/write helpers — the Internal Analyst System (cx-portal-
    // dashboard.html / cx-review-workspace.html / cx-report-generator.html)
    // needs staff to read AND perform review-tier writes on every company's
    // Risk OS data, not just companies they happen to also hold a
    // ros_members_v1 role in. Company-only writes (answers, evidence,
    // facilities — anything gated by rosWriteRoles()) deliberately do NOT
    // get a staff bypass: staff reviews a company's submission, it never
    // edits it on the company's behalf.
    function isStaffOrCompanyMember(companyId) { return isCompanyMember(companyId) || isClimactixStaff(); }
    function isStaffOrHasAnyRole(companyId, roles) { return hasAnyRole(companyId, roles) || isClimactixStaff(); }
    // Assessment status state machine — mirrors the FastAPI design this
    // replaced, enforced declaratively since there's no server code here.
    function rosTransitionAllowed(from, to) {
      return (from == 'draft' && to == 'in_progress')
          || (from == 'in_progress' && to == 'submitted')
          || (from == 'submitted' && to == 'under_review')
          || (from == 'under_review' && (to == 'evidence_requested' || to == 'validated' || to == 'rejected'))
          || (from == 'evidence_requested' && to == 'under_review')
          || (from == 'validated' && (to == 'approved' || to == 'rejected'))
          || (from == 'approved' && to == 'archived')
          || (from == 'rejected' && (to == 'in_progress' || to == 'archived'));
    }

    // ── Posts — one document per post ──────────────────────────────────
    match /cx_posts_v1/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      // The author can edit/delete their own post outright. Any other
      // signed-in user may only touch the social-interaction fields
      // (like/comment/react/view) — never rewrite someone else's content.
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        onlyChangedFields(['likes', 'comments', 'reactions', 'views'])
      );
      allow delete: if isOwner(resource.data.authorId);
    }

    // ── Profiles — one document per user, doc id == uid ─────────────────
    match /cx_profiles_v1/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      // Full self-edit. Other users may only bump the derived counters —
      // their own actions (follow/like/post) touch someone else's profile
      // — never bio/name/company/etc.
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        onlyChangedFields(['followersCount', 'followingCount', 'postsCount', 'climateScore'])
      );
      allow delete: if false;
    }

    // ── Follows — one document per follower, doc id == follower uid ─────
    match /cx_follows_v1/{userId} {
      allow read: if signedIn();       // needed for getFollowers() cross-user queries
      allow write: if isOwner(userId); // only you can edit who you follow
    }

    // ── Bookmarks — private, one document per user ──────────────────────
    match /cx_bookmarks_v1/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Notifications — private, one document per user ──────────────────
    // Written on behalf of the recipient by whichever user's action
    // triggered it (e.g. someone liking your post writes to YOUR
    // notifications doc), so this can't be owner-only on write.
    match /cx_notifs_v1/{userId} {
      allow read: if isOwner(userId);
      allow write: if signedIn();
    }

    // ── Score history — one document per user ────────────────────────────
    // Same reasoning as notifications: any user's action can award points
    // to a DIFFERENT user, so write can't be owner-only. Read is open to
    // all signed-in users because the weekly/monthly leaderboard needs to
    // aggregate every user's score history.
    match /cx_scores_v2/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ── Streaks — private, one document per user ─────────────────────────
    match /cx_streaks_v1/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Daily challenge state — private, one document per user per day ──
    // Doc id is `${userId}_${date}` — check the uid prefix against auth.
    match /cx_challenges_v2/{docId} {
      allow read, write: if signedIn() && docId.split('_')[0] == request.auth.uid;
    }

    // ── Joined communities — private, one document per user ──────────────
    match /cx_joined_v1/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Forum threads — one document per thread ──────────────────────────
    match /cx_forum_v1/{threadId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        onlyChangedFields(['voters', 'upvotes', 'downvotes', 'replies', 'replyCount'])
      );
      allow delete: if isOwner(resource.data.authorId);
    }

    // ── Funding requests — one document per request ──────────────────────
    // KNOWN LIMITATION: funding-hub.html's submission form does not record
    // a founder uid on the request (only a display name), so unlike posts/
    // forum/solutions/battles there is no real authorId field to check
    // ownership against. Any signed-in user can create/update a request
    // document. If funding-hub.html starts sending `founderId: currentUser.uid`,
    // tighten this the same way as posts.
    match /cx_funding_user_v1/{requestId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ── Solutions — one document per entry ────────────────────────────────
    match /cx_solutions_v1/{solutionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        onlyChangedFields(['upvotes', 'bookmarks'])
      );
      allow delete: if isOwner(resource.data.authorId);
    }

    // ── Battles — one document per battle ─────────────────────────────────
    match /cx_battles_v1/{battleId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        onlyChangedFields(['votes', 'totalA', 'totalB'])
      );
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // RISK OS — Climate Intelligence Due Diligence Workspace
    // Full design: RISK_OS_COLLABORATION_ARCHITECTURE.md
    // ══════════════════════════════════════════════════════════════════

    // ── Companies — one document per assessed entity ────────────────────
    match /ros_companies_v1/{companyId} {
      allow read: if isStaffOrCompanyMember(companyId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasAnyRole(companyId, rosAdminRoles());
      allow delete: if false;
    }

    // ── Company membership — doc id `${companyId}_${uid}` ───────────────
    // System `role` (access level) and `department` (who to @mention/
    // assign to) are separate fields — see architecture doc §3.
    match /ros_members_v1/{memberId} {
      allow read: if isCompanyMember(resource.data.companyId);
      allow create: if signedIn() && (
        // Founding administrator, self-onboarding immediately after creating
        // the company — verified against the company doc's own createdBy,
        // not just a client-asserted field on this membership doc, so a
        // stranger can't self-appoint administrator on someone ELSE's company.
        (
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role == 'administrator' &&
          get(/databases/$(database)/documents/ros_companies_v1/$(request.resource.data.companyId)).data.createdBy == request.auth.uid
        ) ||
        // An existing admin/owner adding someone else.
        hasAnyRole(request.resource.data.companyId, rosAdminRoles())
      );
      allow update: if hasAnyRole(resource.data.companyId, rosAdminRoles());
      allow delete: if hasAnyRole(resource.data.companyId, ['administrator']);
    }

    // ── Assessments ───────────────────────────────────────────────────────
    match /ros_assessments_v1/{assessmentId} {
      allow read: if isStaffOrCompanyMember(resource.data.companyId);
      allow create: if hasAnyRole(request.resource.data.companyId, rosWriteRoles())
                     && request.resource.data.status == 'draft';
      allow update: if isStaffOrCompanyMember(resource.data.companyId) && (
        (
          // Content edit, no status change.
          request.resource.data.status == resource.data.status &&
          hasAnyRole(resource.data.companyId, rosWriteRoles())
        ) || (
          // Status transition — must follow the state machine, and the
          // heavier review-tier states require reviewer/approver/admin —
          // or Climactix staff, via the Internal Analyst System's
          // approve/reject/request-clarification actions.
          request.resource.data.status != resource.data.status &&
          rosTransitionAllowed(resource.data.status, request.resource.data.status) &&
          (
            (request.resource.data.status in ['in_progress', 'submitted']
              && hasAnyRole(resource.data.companyId, rosWriteRoles())) ||
            (request.resource.data.status in
              ['under_review', 'evidence_requested', 'validated', 'approved', 'rejected', 'archived']
              && isStaffOrHasAnyRole(resource.data.companyId, rosReviewRoles()))
          )
        )
      );
      allow delete: if false;
    }

    // ── Answers — doc id `${assessmentId}_${questionId}` ─────────────────
    match /ros_answers_v1/{answerId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create, update: if
        hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles());
      allow delete: if false;
    }

    // ── Answer version history — append-only ─────────────────────────────
    match /ros_answer_versions_v1/{versionId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create: if hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles());
      allow update, delete: if false;
    }

    // ── C-LAYER scores — doc id `${assessmentId}_${clayerId}` ────────────
    match /ros_clayer_scores_v1/{scoreId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow write: if hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles());
    }

    // ── Evidence — file bytes live in Storage; this is metadata ──────────
    match /ros_evidence_v1/{evidenceId} {
      allow read: if isStaffOrCompanyMember(resource.data.companyId);
      allow create: if hasAnyRole(request.resource.data.companyId, rosWriteRoles());
      // Only the review/verification fields may change after upload — the
      // uploaded file record itself (filename/storagePath/hash) is immutable.
      // Climactix staff reviewing via the Internal Analyst System can also
      // set verification status, same as a company-side reviewer role.
      allow update: if isStaffOrHasAnyRole(resource.data.companyId, rosReviewRoles())
                     && onlyChangedFields(['reviewStatus', 'verifiedBy', 'verifiedAt', 'tags', 'description']);
      allow delete: if false;
    }

    // ── AI evidence reviews — written ONLY by the Cloud Function ─────────
    // (Admin SDK bypasses rules; clients can read results but never write
    // or spoof them — see functions/main.py: request_evidence_ai_review.)
    match /ros_ai_reviews_v1/{reviewId} {
      allow read: if isStaffOrCompanyMember(resource.data.companyId);
      allow write: if false;
    }

    // ── Comments — threaded, per-question ─────────────────────────────────
    match /ros_comments_v1/{commentId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create: if isStaffOrCompanyMember(companyOfAssessment(request.resource.data.assessmentId))
                     && request.resource.data.authorId == request.auth.uid;
      allow update: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId)) && (
        resource.data.authorId == request.auth.uid ||
        onlyChangedFields(['resolved', 'resolvedBy', 'resolvedAt', 'pinned', 'updatedAt'])
      );
      allow delete: if false; // soft-delete via deletedAt, not a real delete
    }

    // ── Assessor Notes — private, reviewer-only (never visible to
    // contributors/read_only, unlike ros_comments_v1 above). Climactix staff
    // reviewing via the Internal Analyst System count as reviewer-tier here
    // too — this collection IS the "+ Note" feature in that workspace.
    match /ros_assessor_notes_v1/{noteId} {
      allow read: if isStaffOrHasAnyRole(companyOfAssessment(resource.data.assessmentId),
                                 rosReviewRoles().concat(['administrator']));
      allow create: if isStaffOrHasAnyRole(companyOfAssessment(request.resource.data.assessmentId),
                                   rosReviewRoles().concat(['administrator']))
                     && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Tasks ───────────────────────────────────────────────────────────
    match /ros_tasks_v1/{taskId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create: if isStaffOrHasAnyRole(companyOfAssessment(request.resource.data.assessmentId),
                                   rosWriteRoles().concat(rosReviewRoles()));
      // The assignee may update their own task's status/progress; write
      // roles and reviewers may reassign/reprioritize.
      allow update: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId)) && (
        resource.data.assignedToUser == request.auth.uid ||
        isStaffOrHasAnyRole(companyOfAssessment(resource.data.assessmentId), rosWriteRoles().concat(rosReviewRoles()))
      );
      allow delete: if false;
    }

    // ── Risk notes ──────────────────────────────────────────────────────
    match /ros_risk_notes_v1/{noteId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create, update: if isStaffOrHasAnyRole(companyOfAssessment(request.resource.data.assessmentId),
                                           rosWriteRoles().concat(rosReviewRoles()));
      allow delete: if false;
    }

    // ── Facilities — geospatial anchors ──────────────────────────────────
    match /ros_facilities_v1/{facilityId} {
      allow read: if isStaffOrCompanyMember(resource.data.companyId);
      allow create, update: if hasAnyRole(request.resource.data.companyId, rosWriteRoles());
      allow delete: if false;
    }

    // ── Financial materiality ─────────────────────────────────────────────
    match /ros_financial_materiality_v1/{recordId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create, update: if hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles());
      allow delete: if false;
    }

    // ── Framework mappings — doc id `${assessmentId}_${frameworkCode}` ───
    match /ros_framework_mappings_v1/{mappingId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow write: if hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles());
    }

    // ── Review actions — return/request-evidence/approve/reject/close.
    // This IS the Internal Analyst System's approve/reject/flag/override
    // action log (spec §13) — staff must be able to create these directly.
    match /ros_review_actions_v1/{actionId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create: if isStaffOrHasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosReviewRoles())
                     && request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Organization notebook — persistent, lifecycle-spanning notes ─────
    match /ros_notebook_v1/{entryId} {
      allow read: if isStaffOrCompanyMember(resource.data.companyId);
      allow create: if isCompanyMember(request.resource.data.companyId)
                     && request.resource.data.authorId == request.auth.uid;
      allow update: if resource.data.authorId == request.auth.uid;
      allow delete: if false;
    }

    // ── Audit log — append-only, immutable once written ───────────────────
    match /ros_audit_log_v1/{logId} {
      allow read: if isStaffOrHasAnyRole(companyOfAssessment(resource.data.assessmentId),
                                 rosReviewRoles().concat(['assessment_owner', 'auditor']));
      allow create: if isCompanyMember(companyOfAssessment(request.resource.data.assessmentId))
                     && request.resource.data.actorUserId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Declarations — Assessment Declaration & Acknowledgement consent
    // gate, submitted immediately before an assessment moves to
    // 'submitted'. Append-only: a re-submission after a methodology or
    // questionnaire revision creates a NEW record rather than overwriting
    // an old one, so each past submission stays reconstructable against
    // the exact declaration/methodology/questionnaire versions accepted.
    match /ros_declarations_v1/{declarationId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create: if hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles())
                     && request.resource.data.submittedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Risk OS notifications reuse the existing cx_notifs_v1 collection and
    // rules above (per-user, write-on-behalf-of pattern) — just new `type`
    // values (assignment/mention/deadline/...), no schema or rule change.

    // ── Methodology versions — reference data, Admin-SDK/seed-script only ──
    match /ros_methodology_versions_v1/{versionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Question bank — reference data, Admin-SDK/seed-script only ────────
    // Source of truth for seeding is climate-risk-os.html's own
    // TYPED_QUESTIONS/BASE_QUESTIONS — see scripts/seed-questions-firestore.js.
    // Client-supplied clayer/questionType on ros_answers_v1 writes is no
    // longer the only source for that mapping once question gating (Phase 3)
    // reads it from here instead of trusting the client.
    match /ros_questions_v1/{questionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ── Entities — legal entity / ownership boundary tree ─────────────────
    // ancestryPath and effectiveOwnershipFromRoot are computed server-side by
    // the onRosEntityWritten Cloud Function trigger (functions/main.py) —
    // clients may never set them directly, the same discipline already
    // applied to ros_ai_reviews_v1 and the ros_members_v1 role-escalation fix.
    // Every entity in one company's tree (parent, subsidiaries, JVs) shares
    // the same top-level companyId field regardless of depth, so the
    // existing one-hop isCompanyMember() check already authorizes the whole
    // subtree — no recursive rule-walking needed.
    match /ros_entities_v1/{entityId} {
      allow read: if isStaffOrCompanyMember(resource.data.companyId);
      allow create: if hasAnyRole(request.resource.data.companyId, rosWriteRoles())
                     && !('ancestryPath' in request.resource.data)
                     && !('effectiveOwnershipFromRoot' in request.resource.data);
      allow update: if hasAnyRole(resource.data.companyId, rosWriteRoles())
                     && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['ancestryPath', 'effectiveOwnershipFromRoot']);
      allow delete: if false; // soft-delete via status:'inactive', preserves ancestry for any children
    }

    // ── Materiality scans — doc id == assessmentId, Cloud-Function-only write ─
    // Written by the runMaterialityScan callable (functions/main.py) so the
    // scan's topic levels can never be spoofed client-side, the same
    // reasoning as ros_ai_reviews_v1.
    match /ros_materiality_scans_v1/{assessmentId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(assessmentId));
      allow write: if false;
    }

    // ── Evidence links — lets one uploaded file serve multiple questions
    // (Evidence Library reuse) without duplicating the upload or mutating
    // the original ros_evidence_v1 doc's own questionId. Append-only.
    match /ros_evidence_links_v1/{linkId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow create: if hasAnyRole(companyOfAssessment(request.resource.data.assessmentId), rosWriteRoles())
                     && request.resource.data.linkedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Contradiction flags — durable, cross-referenced version of what
    // the client's own detectContradictions() computes ephemerally, plus
    // findings from AI evidence review and the evidence-graph traversal.
    // Cloud-Function-only write, same discipline as ros_ai_reviews_v1 —
    // a flag's existence must never be spoofable by a client.
    match /ros_contradiction_flags_v1/{flagId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow write: if false;
    }

    // ── Evidence graph — one doc per node (entity/asset/geography/hazard/
    // financial_exposure/disclosure/evidence/question), built by the
    // compute_evidence_graph Cloud Function trigger. Cloud-Function-only
    // write — never a generic client-writable graph.
    match /ros_evidence_graph_v1/{nodeId} {
      allow read: if isStaffOrCompanyMember(companyOfAssessment(resource.data.assessmentId));
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    // CLIMACTIX EVIDENCE INTELLIGENCE AGENT — spec-driven evidence
    // verification pipeline (services/evidence_intelligence_agent.py).
    // Backend-team-only tool: read access is isClimactixStaff(), NOT
    // isCompanyMember() — the entity being assessed must never see how its
    // own evidence was scored/flagged (this is explicitly what CLAUDE.md's
    // "Climactix Internal Team" role reviews, distinct from the Enterprise
    // User role that submitted the evidence). Every one of these is also
    // Cloud-Function-only write, same discipline as ros_ai_reviews_v1/
    // ros_contradiction_flags_v1/ros_evidence_graph_v1 above — a claim's
    // extraction, a confidence score, or an entity's aggregate greenwashing-
    // risk banner can never be spoofed client-side. Written by
    // run_evidence_intelligence_analysis (staff-invoked) and onEvidenceCreated
    // (auto-runs on every evidence upload, Admin SDK — see functions/main.py),
    // plus recompute_entity_intelligence for the entity-level rollup.
    // ══════════════════════════════════════════════════════════════════

    // ── Climactix staff roster — who counts as "Backend team." Admin-SDK/
    // console-managed only; staff can see the roster, no one can write it
    // from a client (adding staff is an internal ops action, not a product
    // feature — mirrors ros_methodology_versions_v1's reference-data pattern).
    match /cx_staff_v1/{uid} {
      allow read: if isClimactixStaff();
      allow write: if false;
    }

    // ── Extracted claims/metrics — one doc per claim or metric per question ──
    match /ros_claims_v1/{claimId} {
      allow read: if isClimactixStaff();
      allow write: if false;
    }

    // ── Evidence Confidence Score — doc id `${assessmentId}_${questionId}` ──
    match /ros_evidence_confidence_v1/{docId} {
      allow read: if isClimactixStaff();
      allow write: if false;
    }

    // ── Entity-level Evidence Intelligence — doc id == assessmentId ─────────
    match /ros_entity_intelligence_v1/{assessmentId} {
      allow read: if isClimactixStaff();
      allow write: if false;
    }

    // ── Generated report snapshots (Internal Analyst System's Report
    // Engine) — one immutable doc per generated+saved report, mirroring
    // ros_declarations_v1's append-only-snapshot discipline: a report is a
    // point-in-time record of what was true when it was generated, not a
    // live view that silently changes if the underlying assessment is later
    // re-scored. Staff-only, both directions — a client-side write here
    // would let a report claim scores that were never actually computed.
    match /ros_reports_v1/{reportId} {
      allow read: if isClimactixStaff();
      allow create: if isClimactixStaff() && request.resource.data.generatedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Assessment agent conversations — doc id `${assessmentId}_${uid}`.
    // Both the user's message and the agent's reply are appended together
    // by the assessment_agent_chat callable (Admin SDK), never by the
    // client directly, so a conversation can never be spoofed or have a
    // fake assistant turn injected. Visible to the owning user and to
    // reviewer-tier roles (so a reviewer can see what an analyst asked).
    match /ros_agent_conversations_v1/{conversationId} {
      allow read: if isOwner(resource.data.userId)
                   || hasAnyRole(companyOfAssessment(resource.data.assessmentId), rosReviewRoles());
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
