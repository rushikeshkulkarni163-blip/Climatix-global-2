# Copy to .env. Never commit .env.
TERMINAL_ENV=production
# 32+ random characters, e.g. `openssl rand -hex 32`
TERMINAL_JWT_SECRET=
POSTGRES_PASSWORD=
# Used outside docker compose:
# TERMINAL_DATABASE_URL=postgresql+psycopg://cxt:PASSWORD@localhost/climactix_terminal

# Browser origin(s) of the Next.js console, comma-separated
TERMINAL_CORS_ORIGINS=https://climactix.global
# Base URL used in invitation and password-reset links
TERMINAL_PUBLIC_APP_URL=https://climactix.global/console

# Document storage: local (default, volume /data/documents) or s3 (install boto3)
TERMINAL_STORAGE_BACKEND=local
# TERMINAL_S3_BUCKET=
# TERMINAL_S3_ENDPOINT=
TERMINAL_MAX_UPLOAD_MB=60

# Public-source retrieval: restrict to these hosts (comma-separated); empty = any public host
TERMINAL_FETCH_ALLOWLIST=
TERMINAL_RESPECT_ROBOTS=true

# Outbound email for invitations and password resets. Without it, links are shown to administrators only.
TERMINAL_SMTP_HOST=
TERMINAL_SMTP_PORT=587
TERMINAL_SMTP_USER=
TERMINAL_SMTP_PASSWORD=
TERMINAL_SMTP_FROM=

# Values below this extraction confidence go to human review
TERMINAL_REVIEW_CONFIDENCE_THRESHOLD=70
