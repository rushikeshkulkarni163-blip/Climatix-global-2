# ── Climactix Global — Next.js Frontend Environment ─────────
# Copy to .env.local

# IAM Service URL (NestJS)
NEXT_PUBLIC_IAM_URL=http://localhost:3100/api/v1

# Server-side IAM URL (for middleware/server components — avoid CORS)
IAM_URL=http://localhost:3100/api/v1

# Intelligence Engine URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mapbox token
NEXT_PUBLIC_MAPBOX_TOKEN=

# Feature flags
NEXT_PUBLIC_ENABLE_SSO=true
NEXT_PUBLIC_ENABLE_MFA=true
NEXT_PUBLIC_ENABLE_ENTERPRISE_SSO=true

# ── Climate Arena (/console/earth) ──────────────────────────
# All optional. Without them the Arena runs on NASA GIBS + Esri imagery,
# an ellipsoid globe (no terrain) and the bundled Mumbai building tileset.
# Cesium ion token: enables Cesium World Terrain and Bing aerial imagery.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Google Map Tiles API key: replaces the Mumbai tileset with Photorealistic 3D Tiles.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Imagery: auto | ion | esri | gibs  (esri needs an ArcGIS licence for commercial production use)
NEXT_PUBLIC_ARENA_IMAGERY=auto
# Where the built datasets and tiles are served from (default: same origin /arena)
NEXT_PUBLIC_ARENA_DATA_URL=
NEXT_PUBLIC_ARENA_TILES_URL=
# OpenAQ v3 key (server-side only): enables ground-monitor air quality, incl. India CPCB stations.
# Without it the Arena says "ground-monitor network not connected" — it never substitutes values.
OPENAQ_API_KEY=
