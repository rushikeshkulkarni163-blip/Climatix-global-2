# ─────────────────────────────────────────────────────────────────────────────
# Climactix Global — Docker Compose Environment (EXAMPLE — placeholders only)
# Copy to .env and fill in real values. Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Keys ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=

# ── App Secret ────────────────────────────────────────────────────────────────
SECRET_KEY=

# ── Mapbox (optional) ────────────────────────────────────────────────────────
MAPBOX_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Earth Observation & Climate Data Repository — all optional.
# Absent = every connector runs in clearly-labeled demo/fallback mode
# automatically (never presented as live data). Add real values any time —
# no code changes needed, the registry picks them up on next restart.
# See docs/earth-observation-architecture.md for full setup steps per provider.
# ─────────────────────────────────────────────────────────────────────────────

# Copernicus Data Space Ecosystem — Sentinel-1/2/3/5P/6 scene discovery (STAC).
# Register an OAuth client at https://dataspace.copernicus.eu/ -> User settings
# -> OAuth clients. Token endpoint: identity.dataspace.copernicus.eu (OAuth2
# client-credentials — NOT the retired SciHub/ESA hub credentials).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copernicus Climate Data Store (new CDS, post CDS-Beta migration) — ERA5/
# ERA5-Land reanalysis. Personal access token from https://cds.climate.copernicus.eu/profile
# (NOT the retired classic api/v2 + "UID:key" format).
CDS_API_TOKEN=

# USGS Landsat M2M API — Collection 2 scene discovery. Generate an
# "Application Token" (not your ERS password) at
# https://ers.cr.usgs.gov/password/appgenerate — the classic username/
# password /login endpoint was deprecated 2025-02-26.
USGS_M2M_USERNAME=
USGS_M2M_APP_TOKEN=

# NASA Earthdata Login (EDL) — CMR/CMR-STAC discovery, umbrella auth for
# SMAP/SWOT/GEDI/OCO-2/3/MODIS/VIIRS/ECOSTRESS (individually enabled in
# later phases). Register at https://urs.earthdata.nasa.gov/users/new
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# NASA POWER climatology requires no key — always live, no placeholder needed.
